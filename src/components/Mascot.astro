---
// The client's own mascot, cut out of their stories (art/cutout.py), as a separate layer so it
// can move over any image. Loops run only while on screen: motion.ts toggles .is-live (data-loop).
// Pose: full body pointing up (the only clean cut-out so far). Motion: hop (squash & stretch
// with a floor shadow), sway or bob.
import { Picture } from 'astro:assets';
import point from '../assets/kid/kid-point.png';

interface Props {
  pose: 'point';
  motion: 'hop' | 'sway' | 'bob';
  sizes: string;
  class?: string;
  eager?: boolean;
}

const { pose, motion, sizes, class: className, eager = false } = Astro.props;
const src = { point }[pose];
---

<div class:list={['kid', `kid--${motion}`, className]} data-loop>
  {motion === 'hop' && <span class="kid__shadow" aria-hidden="true" />}
  <Picture
    class="kid__body"
    src={src}
    formats={['avif', 'webp']}
    fallbackFormat="png"
    widths={[200, 300, src.width]}
    sizes={sizes}
    quality={70}
    loading={eager ? 'eager' : 'lazy'}
    alt=""
  />
</div>

<style>
  .kid { pointer-events: none; }

  .kid :global(.kid__body),
  .kid :global(.kid__body img) {
    display: block;
    width: 100%;
    height: auto;
    transform-origin: 50% 100%;
  }

  .kid__shadow {
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: -5%;
    height: 5%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(16 16 32 / 0.38), transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .kid--hop.is-live :global(.kid__body) { animation: hop 1.5s infinite; }
    .kid--hop.is-live .kid__shadow { animation: shadow 1.5s infinite; }
    .kid--sway.is-live :global(.kid__body) { animation: sway 3.4s ease-in-out infinite alternate; }
    .kid--bob.is-live :global(.kid__body) { animation: bob 2.2s ease-in-out infinite alternate; }
  }

  /* Squash on contact, stretch on the way up and down, rest at the apex. */
  @keyframes hop {
    0% { transform: translateY(0) scale(1.06, 0.94); animation-timing-function: cubic-bezier(0.25, 0.8, 0.4, 1); }
    14% { transform: translateY(-6%) scale(0.96, 1.05); animation-timing-function: cubic-bezier(0.2, 0.6, 0.4, 1); }
    50% { transform: translateY(-14%) scale(1, 1); animation-timing-function: cubic-bezier(0.6, 0, 0.8, 0.4); }
    86% { transform: translateY(-4%) scale(0.97, 1.04); animation-timing-function: linear; }
    100% { transform: translateY(0) scale(1.06, 0.94); }
  }

  @keyframes shadow {
    0%, 100% { transform: scale(1); opacity: 1; animation-timing-function: cubic-bezier(0.25, 0.8, 0.4, 1); }
    50% { transform: scale(0.55); opacity: 0.4; animation-timing-function: cubic-bezier(0.6, 0, 0.8, 0.4); }
  }

  @keyframes sway {
    from { transform: rotate(-2deg); }
    to { transform: rotate(2deg) translateY(-1%); }
  }

  @keyframes bob {
    from { transform: translateY(2%) rotate(-1.5deg); }
    to { transform: translateY(-3%) rotate(1.5deg); }
  }
</style>
