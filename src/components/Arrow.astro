---
// Arrow icon for buttons: "ne" (↗, external / go) or "down" (↓, scroll).
interface Props {
  dir?: 'ne' | 'down';
}
const { dir = 'ne' } = Astro.props;
---

<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-dir={dir}>
  {dir === 'ne' ? <path d="M7 17 17 7M8.5 7H17v8.5" /> : <path d="M12 4v15M6 13l6 6 6-6" />}
</svg>
