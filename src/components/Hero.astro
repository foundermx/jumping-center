---
import { Picture } from 'astro:assets';
import Arrow from './Arrow.astro';
import park from '../assets/renders/hero.webp';
import kid from '../assets/kid/kid-point.png';
import { CITY } from '../data/site';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow"><span class="pin" aria-hidden="true"></span>{CITY}</p>
      <h1 class="display hero__title" id="hero-title">
        <span class="line"><span>Salta sin</span></span>
        <span class="line"><span>límites.</span></span>
      </h1>
      <p class="lead hero__lead">Recorre el parque antes de tu primer salto.</p>
      <a class="btn hero__cta" href="#parque">Explorar el parque <Arrow dir="down" /></a>
    </div>

    <figure class="hero__art" data-loop>
      <svg class="hero__orbit" viewBox="0 0 1000 520" fill="none" aria-hidden="true">
        <ellipse cx="500" cy="260" rx="480" ry="215" pathLength="1" />
      </svg>
      <Picture
        class="hero__park"
        src={park}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 900px) 60vw, 100vw"
        quality={52}
        loading="eager"
        fetchpriority="high"
        alt="Maqueta del parque Jumping Center: cancha de trampolines, zona de retos, zona infantil y mesas de fiesta"
      />
      <!-- Same box as the park picture, so the mascot can stand on a bed of the court in it. -->
      <div class="court" style={`aspect-ratio: ${park.width} / ${park.height}`}>
        <div class="hero__kid">
          <span class="hero__kid-shadow" aria-hidden="true"></span>
          <Picture
            src={kid}
            formats={['avif', 'webp']}
            fallbackFormat="png"
            widths={[140, 240, 360]}
            sizes="(min-width: 900px) 9vw, 17vw"
            quality={70}
            loading="eager"
            alt=""
          />
        </div>
      </div>
      <i class="cube cube--a" aria-hidden="true"></i>
      <i class="cube cube--b" aria-hidden="true"></i>
      <i class="cube cube--c" aria-hidden="true"></i>
    </figure>
  </div>

  <div class="container hero__foot" data-loop>
    <a class="hint" href="#parque">Desliza para explorar <span class="chev" aria-hidden="true"></span></a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(24px, 4vw, 56px);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.3fr);
    align-items: center;
    gap: clamp(8px, 2vw, 40px);
    min-height: min(calc(100svh - var(--header-h) - 150px), 760px);
  }

  .hero__copy { position: relative; z-index: 2; padding-bottom: 24px; }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: clamp(14px, 1.6vw, 22px);
  }

  .pin {
    width: 12px;
    height: 12px;
    border-radius: 50% 50% 50% 0;
    background: var(--lime);
    rotate: -45deg;
    box-shadow: inset 0 0 0 3px var(--ink);
  }

  .hero__title { font-size: var(--step-hero); }
  .hero__title .line { display: block; overflow: clip; padding-bottom: 0.12em; margin-bottom: -0.12em; }
  .hero__title .line > span { display: block; }

  .hero__lead {
    max-width: 34ch;
    text-wrap: pretty;
    margin: clamp(14px, 1.6vw, 22px) 0 clamp(22px, 2.4vw, 34px);
    color: var(--ink-soft);
  }

  .hero__art {
    position: relative;
    margin-right: calc(-1 * var(--gutter));
    aspect-ratio: 4 / 3;
  }

  .hero__park :global(img),
  .hero__park {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hero__orbit {
    position: absolute;
    left: -6%;
    right: -2%;
    top: 30%;
    width: 108%;
    z-index: 0;
    overflow: visible;
  }

  .hero__orbit ellipse {
    stroke: var(--lime-deep);
    stroke-width: 2.5;
    stroke-dasharray: 1;
    vector-effect: non-scaling-stroke;
  }

  /* The mascot standing on the front-middle bed of the court (its centre, measured on hero.webp). */
  .court {
    position: absolute;
    z-index: 3;
    left: 0;
    top: 50%;
    width: 100%;
    translate: 0 -50%;
    pointer-events: none;
  }

  .hero__kid {
    position: absolute;
    left: 48.85%;
    top: 66.57%;
    width: 14%;
    translate: -50% -97%;
  }
  .hero__kid :global(img) { display: block; width: 100%; height: auto; }

  .hero__kid-shadow {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: -1%;
    height: 8%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(6 8 30 / 0.5), transparent);
  }

  .cube {
    position: absolute;
    z-index: 2;
    width: clamp(18px, 2.2vw, 34px);
    aspect-ratio: 1;
    border-radius: 24%;
    background: linear-gradient(145deg, #e2ff74, var(--lime-deep));
    box-shadow: inset -4px -5px 0 rgb(0 0 0 / 0.1);
  }
  .cube--a { left: 6%; top: 18%; rotate: 18deg; }
  .cube--b { right: 9%; top: 6%; rotate: -12deg; background: linear-gradient(145deg, #4f6af0, var(--blue)); width: clamp(14px, 1.6vw, 26px); }
  .cube--c { left: 44%; bottom: 2%; rotate: 36deg; width: clamp(12px, 1.3vw, 20px); }

  /* ---------------------------------------------------------------- scroll hint */

  .hero__foot {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    padding: 18px 0 26px;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .hint {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    white-space: nowrap;
  }

  .chev {
    width: 10px;
    height: 10px;
    border-right: 2.5px solid currentColor;
    border-bottom: 2.5px solid currentColor;
    rotate: 45deg;
    translate: 0 -3px;
  }

  /* ---------------------------------------------------------------- mobile */

  @media (width < 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 0;
    }
    .hero__copy { padding-bottom: 8px; }
    .hero__art { margin-inline: calc(-1 * var(--gutter)); }
    .hero__foot { display: none; }
  }

  /* ---------------------------------------------------------------- motion */

  @media (prefers-reduced-motion: no-preference) {
    .hero__eyebrow { animation: rise 0.8s var(--ease-out) 0.05s both; }
    .hero__title .line > span { animation: mask-up 1.1s var(--ease-out) both; }
    .hero__title .line:nth-child(1) > span { animation-delay: 0.12s; }
    .hero__title .line:nth-child(2) > span { animation-delay: 0.24s; }
    .hero__lead { animation: rise 0.9s var(--ease-out) 0.45s both; }
    .hero__cta { animation: pop 0.8s var(--ease-spring) 0.6s both; }
    .hero__park { animation: unveil 1.4s var(--ease-io) both; }
    .hero__orbit ellipse { animation: draw 1.8s var(--ease-io) 0.7s both; }
    .cube { animation: pop 0.7s var(--ease-spring) both; }
    .cube--a { animation-delay: 1s; }
    .cube--b { animation-delay: 1.12s; }
    .cube--c { animation-delay: 1.24s; }
    .hero__foot { animation: rise 0.9s var(--ease-out) 0.9s both; }

    /* Idle loops run only while the hero is on screen (data-loop → .is-live). */
    .hero__art.is-live .cube { animation: pop 0.7s var(--ease-spring) both, bob 5s ease-in-out 1.6s infinite; }
    .hero__art.is-live .cube--b { animation-duration: 0.7s, 6.4s; }
    .hero__art.is-live .cube--c { animation-duration: 0.7s, 4.6s; }
    .hero__foot.is-live .chev { animation: nudge 1.8s ease-in-out infinite; }
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(24px); }
  }
  @keyframes mask-up {
    from { transform: translateY(110%); }
  }
  @keyframes pop {
    from { opacity: 0; transform: scale(0.6); }
  }
  /* Starts partly open: the park is the LCP element, so it must paint on the first frame. */
  @keyframes unveil {
    from { clip-path: inset(0 0 0 45% round 40px); transform: translateX(5%) scale(1.04); }
    to { clip-path: inset(0 0 0 0 round 0); }
  }
  @keyframes draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes bob {
    50% { transform: translateY(-14px) rotate(14deg); }
  }
  @keyframes nudge {
    50% { translate: 0 2px; }
  }
</style>
