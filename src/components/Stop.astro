---
// One stop of the park tour. Same content shape for all four, a different composition and
// entrance per variant so each zone has its own rhythm.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ZONES } from '../data/site';

interface Props {
  index: number;
  image: ImageMetadata;
  variant: 'overlay' | 'panel' | 'curve' | 'party';
}

const { index, image, variant } = Astro.props;
const zone = ZONES[index];
const total = ZONES.length;
const sizes = variant === 'overlay' ? '100vw' : '(min-width: 900px) 64vw, 100vw';

// Confetti for the party stop: final offset (% of the burst box), turn and colour per piece.
const confetti = [
  [-38, -30, 40, '#ff4f9a'], [-12, -44, -25, '#ffffff'], [18, -38, 70, '#1d37d2'], [44, -22, -40, '#ff4f9a'],
  [-46, 6, 15, '#1d37d2'], [52, 10, 110, '#ffc928'], [-24, 30, -70, '#ffc928'], [30, 34, 30, '#19c6e6'],
  [6, -54, 95, '#19c6e6'], [-56, -16, -100, '#ffffff'],
] as const;
---

<section class:list={['stop', `stop--${variant}`]} id={zone.id} aria-labelledby={`${zone.id}-title`} data-reveal="stop">
  <div class="stop__media">
    <Picture
      class="stop__img"
      src={image}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[640, 960, 1280, 1800]}
      sizes={sizes}
      quality={52}
      alt={zone.alt}
    />
    <slot name="media" />
  </div>

  <div class="stop__panel">
    <div class="stop__copy">
      <p class="counter">
        <span>{`0${index + 1} / 0${total}`}</span>
        <span class="counter__dots" aria-hidden="true">
          {ZONES.map((_, i) => <i class:list={{ 'is-current': i === index }} />)}
        </span>
      </p>
      <h2 class="display stop__title lines" id={`${zone.id}-title`} data-reveal="lines" style="--d: 120ms">
        {zone.lines.map((line, i) => <span style={`--i: ${i}`}><span>{line}</span></span>)}
      </h2>
      <p class="lead stop__text">{zone.text}</p>
      <slot />
    </div>
  </div>
  <slot name="deco" />
  {
    variant === 'panel' && (
      <svg class="deco-arc" viewBox="0 0 600 260" fill="none" aria-hidden="true">
        <path d="M8 250C160 160 360 70 592 30" pathLength="1" />
      </svg>
    )
  }
  {
    variant === 'curve' && (
      <div class="deco-balls" aria-hidden="true">
        <i />
        <i />
        <i />
      </div>
    )
  }
  {
    variant === 'party' && (
      <div class="deco-confetti" aria-hidden="true">
        {confetti.map(([x, y, r, c]) => (
          <i style={`--x: ${x}cqw; --y: ${y}cqh; --r: ${r}deg; --c: ${c}`} />
        ))}
      </div>
    )
  }
</section>

<style>
  .stop {
    position: relative;
    isolation: isolate;
  }

  .stop__media {
    position: relative;
    overflow: hidden;
  }

  /* <picture> and <img> both fill the frame, whatever gives the frame its height. */
  .stop__media :global(picture),
  .stop__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .stop__title { font-size: var(--step-1); }
  .stop__text { margin-top: clamp(10px, 1.2vw, 18px); max-width: 26ch; }
  .stop__copy :global(.btn) { margin-top: clamp(20px, 2.4vw, 32px); }
  .counter { margin-bottom: clamp(14px, 1.8vw, 26px); }

  /* ================================================================ 01 overlay: full bleed */
  .stop--overlay {
    height: clamp(560px, 82svh, 860px);
    color: #fff;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 calc(100% - 4.5vw));
  }
  .stop--overlay .stop__media { position: absolute; inset: 0; }
  .stop--overlay .stop__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(170deg, rgb(6 23 106 / 0.94) 0%, rgb(11 35 148 / 0.78) 26%, rgb(11 35 148 / 0) 58%),
      linear-gradient(90deg, rgb(6 23 106 / 0.55), transparent 50%);
  }
  .stop--overlay .stop__media :global(img) { object-position: 50% 62%; }
  .stop--overlay .stop__panel {
    position: relative;
    z-index: 1;
    width: min(100% - 2 * var(--gutter), var(--max));
    margin-inline: auto;
    padding-top: clamp(40px, 7vw, 96px);
  }
  .stop--overlay .stop__title { font-size: clamp(3rem, 1.2rem + 7vw, 8rem); }
  .stop--overlay .counter__dots i:not(.is-current) { opacity: 0.7; }

  /* ================================================================ 02 panel: royal slab */
  .stop--panel {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    min-height: clamp(520px, 66vw, 760px);
    margin-top: -4.5vw;
    background: var(--royal);
    color: #fff;
    clip-path: polygon(0 0, 100% 4.5vw, 100% calc(100% - 3vw), 0 100%);
  }
  .stop--panel .stop__media { clip-path: polygon(0 0, 100% 0, 88% 100%, 0 100%); }
  .stop--panel .stop__panel {
    display: grid;
    align-items: center;
    padding: 8vw var(--gutter) 6vw clamp(12px, 2vw, 32px);
  }

  /* ================================================================ 03 curve: cream + arc */
  .stop--curve {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    min-height: clamp(520px, 56vw, 720px);
    margin-top: -3vw;
    padding-top: 3vw;
  }
  .stop--curve .stop__panel {
    grid-row: 1;
    grid-column: 1;
    display: grid;
    align-items: center;
    padding: 6vw clamp(12px, 3vw, 48px) 6vw max(var(--gutter), (100vw - var(--max)) / 2);
  }
  .stop--curve .stop__media {
    grid-row: 1;
    grid-column: 2;
    clip-path: ellipse(92% 125% at 100% 50%);
  }

  /* ================================================================ 04 party: lime field */
  .stop--party {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    min-height: clamp(540px, 56vw, 740px);
    background: var(--lime);
  }
  .stop--party .stop__panel {
    grid-row: 1;
    grid-column: 1;
    position: relative;
    z-index: 2;
    display: grid;
    align-items: center;
    padding: 6vw clamp(12px, 3vw, 48px) 6vw max(var(--gutter), (100vw - var(--max)) / 2);
  }
  .stop--party .stop__media {
    grid-row: 1;
    grid-column: 2;
    margin: clamp(16px, 2.4vw, 36px) 0;
    border-radius: var(--radius) 0 0 var(--radius);
  }

  /* ================================================================ decorations */
  .deco-arc {
    position: absolute;
    right: 0;
    bottom: 3vw;
    width: 32%;
    stroke: var(--lime);
    stroke-width: 3;
    stroke-dasharray: 1;
    vector-effect: non-scaling-stroke;
    pointer-events: none;
  }

  .deco-balls {
    position: absolute;
    z-index: 2;
    left: 36%;
    bottom: 7%;
    display: flex;
    align-items: flex-end;
    gap: 10px;
    pointer-events: none;
  }
  .deco-balls i {
    width: clamp(26px, 3.4vw, 50px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 34% 30%, #f4ffc4, var(--lime) 38%, var(--lime-deep) 100%);
    box-shadow: 0 10px 14px -8px rgb(16 16 32 / 0.45);
  }
  .deco-balls i:nth-child(2) { width: clamp(20px, 2.4vw, 34px); background: radial-gradient(circle at 34% 30%, #b8c6ff, var(--blue) 45%, var(--royal) 100%); }
  .deco-balls i:nth-child(3) { width: clamp(16px, 1.8vw, 26px); background: radial-gradient(circle at 34% 30%, #c9f6ff, #19c6e6 45%, #0b8fb0 100%); }

  .deco-confetti {
    position: absolute;
    z-index: 3;
    left: 6%;
    top: 4%;
    width: 40%;
    height: 40%;
    container-type: size;
    pointer-events: none;
  }
  .deco-confetti i {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 9px;
    height: 20px;
    border-radius: 3px;
    background: var(--c);
    transform: translate(var(--x), var(--y)) rotate(var(--r));
  }

  /* ================================================================ mobile compositions */
  @media (width < 900px) {
    .stop--overlay { height: auto; min-height: 640px; clip-path: polygon(0 0, 100% 0, 100% 100%, 0 calc(100% - 36px)); }
    .stop--overlay .stop__media :global(img) { object-position: 62% 50%; }
    .stop--overlay .stop__media::after {
      background: linear-gradient(180deg, rgb(6 23 106 / 0.95) 0%, rgb(11 35 148 / 0.75) 34%, rgb(11 35 148 / 0) 64%);
    }
    .stop--panel,
    .stop--curve,
    .stop--party { grid-template-columns: 1fr; min-height: 0; }
    .stop--panel { margin-top: -36px; clip-path: polygon(0 0, 100% 36px, 100% calc(100% - 28px), 0 100%); }
    .stop--panel .stop__media { aspect-ratio: 4 / 3.2; clip-path: none; }
    .stop--panel .stop__panel { padding: 36px var(--gutter) 64px; }
    .stop--curve { margin-top: -28px; padding-top: 28px; }
    .stop--curve .stop__panel,
    .stop--party .stop__panel { grid-row: 1; padding: 40px var(--gutter) 28px; }
    .stop--curve .stop__media { grid-row: 2; grid-column: 1; aspect-ratio: 4 / 3.3; clip-path: ellipse(130% 100% at 50% 100%); }
    .stop--party .stop__media { grid-row: 2; grid-column: 1; aspect-ratio: 4 / 3.3; margin: 0 0 0 var(--gutter); }
    .deco-confetti { left: auto; right: 2%; top: 2%; width: 42%; height: 20%; z-index: 0; }
    .deco-arc { width: 60%; bottom: 10px; }
    .deco-balls { left: auto; right: 10%; bottom: 3%; }
  }

  /* ================================================================ motion: one entrance per variant */
  @media (prefers-reduced-motion: no-preference) {
    /* Entrances move the <picture>; the parallax below moves the <img> inside it, so they compose. */
    :global(.js) .stop__media > :global(picture) {
      transition: scale 1.8s var(--ease-out), opacity 1s var(--ease-out), translate 1.3s var(--ease-out);
    }
    :global(.js) .stop .stop__text,
    :global(.js) .stop .counter,
    :global(.js) .stop__copy :global(.btn) {
      transition: opacity 0.9s var(--ease-out), transform 1s var(--ease-out);
    }
    :global(.js) .stop .counter { transition-delay: 60ms; }
    :global(.js) .stop .stop__text { transition-delay: 380ms; }
    :global(.js) .stop__copy :global(.btn) { transition-delay: 520ms; }
    :global(.js) .stop:not(:global(.is-in)) .counter,
    :global(.js) .stop:not(:global(.is-in)) .stop__text,
    :global(.js) .stop:not(:global(.is-in)) .stop__copy :global(.btn) { opacity: 0; transform: translateY(22px); }

    /* 01: the hall settles in from a slow push-in */
    :global(.js) .stop--overlay:not(:global(.is-in)) .stop__media > :global(picture) { scale: 1.22; }

    /* 02: the royal slab wipes across, the frame slides in under it */
    :global(.js) .stop--panel .stop__panel { transition: clip-path 1.1s var(--ease-io); }
    :global(.js) .stop--panel:not(:global(.is-in)) .stop__panel { clip-path: inset(0 0 0 100%); }
    :global(.js) .stop--panel:not(:global(.is-in)) .stop__media > :global(picture) { translate: -7% 0; opacity: 0.2; }

    /* 03: the play area opens out of the curve */
    :global(.js) .stop--curve .stop__media { transition: clip-path 1.4s var(--ease-io) 0.1s; }
    :global(.js) .stop--curve:not(:global(.is-in)) .stop__media { clip-path: ellipse(0% 125% at 100% 50%); }
    :global(.js) .stop--curve:not(:global(.is-in)) .stop__media > :global(picture) { scale: 1.15; }

    /* 04: the party room rises into place */
    :global(.js) .stop--party .stop__media { transition: clip-path 1.2s var(--ease-io), translate 1.2s var(--ease-out); }
    :global(.js) .stop--party:not(:global(.is-in)) .stop__media { clip-path: inset(100% 0 0 0 round var(--radius)); translate: 0 40px; }

    /* decorations join in after the frame */
    :global(.js) .deco-arc path { transition: stroke-dashoffset 1.6s var(--ease-io) 0.5s; }
    :global(.js) .stop:not(:global(.is-in)) .deco-arc path { stroke-dashoffset: 1; }
    :global(.js) .stop.is-in .deco-balls i { animation: drop 1.3s both; }
    :global(.js) .stop:not(:global(.is-in)) .deco-balls i { opacity: 0; }
    .deco-balls i:nth-child(1) { animation-delay: 0.6s; }
    .deco-balls i:nth-child(2) { animation-delay: 0.75s; }
    .deco-balls i:nth-child(3) { animation-delay: 0.9s; }
    :global(.js) .stop.is-in .deco-confetti i { animation: burst 1.1s var(--ease-out) 0.35s both; }
    :global(.js) .stop:not(:global(.is-in)) .deco-confetti i { opacity: 0; }

    @media (width < 900px) {
      :global(.js) .stop--curve:not(:global(.is-in)) .stop__media { clip-path: ellipse(0% 0% at 50% 100%); }
    }
  }

  /* Gentle parallax inside the frames, desktop only, off the main thread where supported. */
  @supports (animation-timeline: view()) {
    @media (width >= 900px) and (prefers-reduced-motion: no-preference) {
      .stop__media :global(img) {
        animation: drift linear both;
        animation-timeline: view();
        scale: 1.1;
      }
    }
  }

  @keyframes drop {
    0% { opacity: 0; transform: translateY(-160px); animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45); }
    40% { opacity: 1; transform: translateY(0) scale(1.12, 0.86); animation-timing-function: cubic-bezier(0, 0.55, 0.45, 1); }
    62% { transform: translateY(-42px) scale(0.96, 1.04); animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45); }
    80% { transform: translateY(0) scale(1.05, 0.95); animation-timing-function: cubic-bezier(0, 0.55, 0.45, 1); }
    90% { transform: translateY(-10px); animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45); }
    100% { opacity: 1; transform: none; }
  }

  @keyframes burst {
    from { opacity: 0; transform: translate(0, 0) rotate(0) scale(0.2); }
  }

  @keyframes drift {
    from { translate: 0 -4.5%; }
    to { translate: 0 4.5%; }
  }
</style>
