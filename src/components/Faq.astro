---
import { FAQ } from '../data/site';
---

<section class="faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <h2 class="display faq__title lines has-sparkle" id="faq-title" data-reveal="lines">
      <span style="--i: 0"><span>Antes</span></span>
      <span style="--i: 1"><span>de saltar</span></span>
      <i class="sparkle" aria-hidden="true"></i>
    </h2>

    <div class="faq__list" data-reveal="list">
      {
        FAQ.map(({ id, q, a }, i) => (
          <details name="faq" id={id} style={`--i: ${i}`}>
            <summary>
              {q}
              <span class="plus" aria-hidden="true" />
            </summary>
            <p>{a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq { padding: clamp(56px, 8vw, 120px) 0 clamp(64px, 9vw, 130px); }

  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: start;
    gap: clamp(28px, 5vw, 80px);
  }

  .faq__title { font-size: var(--step-2); }

  details {
    border-top: 1.5px solid var(--cream-2);
  }
  details:last-child { border-bottom: 1.5px solid var(--cream-2); }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 64px;
    padding: 18px 2px;
    font-size: clamp(1.1rem, 0.95rem + 0.7vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    cursor: pointer;
    list-style: none;
    transition: color 0.3s;
  }
  summary::-webkit-details-marker { display: none; }

  .plus {
    position: relative;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    transition: background 0.35s var(--ease-out), rotate 0.5s var(--ease-spring);
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 16px;
    height: 2.5px;
    border-radius: 2px;
    background: currentColor;
    translate: -50% -50%;
  }
  .plus::after { rotate: 90deg; }

  details[open] .plus { rotate: 135deg; background: var(--lime); }

  @media (hover: hover) and (pointer: fine) {
    summary:hover { color: var(--blue); }
    summary:hover .plus { background: color-mix(in srgb, var(--lime) 55%, transparent); }
  }

  details p {
    max-width: 58ch;
    padding: 0 2px 22px;
    color: var(--ink-soft);
  }

  /* Smooth open/close where ::details-content is supported; elsewhere it simply snaps. */
  details::details-content {
    block-size: 0;
    overflow: clip;
    transition: block-size 0.45s var(--ease-out), content-visibility 0.45s allow-discrete;
  }
  details[open]::details-content { block-size: auto; }

  @media (width < 900px) {
    .faq__grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .faq__list details { transition: opacity 0.8s var(--ease-out), translate 0.9s var(--ease-out); transition-delay: calc(var(--i) * 90ms + 150ms); }
    :global(.js) .faq__list:not(:global(.is-in)) details { opacity: 0; translate: 48px 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    details::details-content { transition: none; }
  }
</style>
